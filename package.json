{
  "name": "hive",
  "private": true,
  "workspaces": [
    "crates/hive-console/editor-js"
  ],
  "devDependencies": {
    "graphql": "16.14.2",
    "pg": "8.23.0",
    "playwright": "1.62.1"
  },
  "scripts": {
    "build": "npm run build:console && cargo build --release",
    "build:service": "cargo build --release --bin hive",
    "generate:schema": "cargo run --release --quiet --bin hive -- schema-sdl > schema/hive.graphql",
    "validate:local": "node scripts/validate-local.mjs",
    "check:standalone": "node scripts/standalone-boundary.mjs",
    "check:dsql-conformance": "node scripts/dsql-conformance.mjs",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --exclude hive-console --all-targets -- -D warnings && cargo test --workspace --exclude hive-console",
    "check:architecture": "node scripts/architecture.mjs",
    "check:idiomatic": "node scripts/idiomatic-gate.mjs --enforce",
    "check:console": "npm run --workspace @hive/console-editor build && cargo clippy -p hive-console --target wasm32-unknown-unknown -- -D warnings && cargo test -p hive-console",
    "check:rust:database": "npm run build:service && node scripts/rust-database-tests.mjs",
    "check:schema:entity-coverage": "npm run build:service && node scripts/entity-coverage-tests.mjs",
    "check:schema:entity-relations": "npm run build:service && node scripts/entity-coverage-tests.mjs",
    "check:schema:contract": "npm run build:service && node scripts/schema-contract.mjs",
    "check:packaging": "npm run build && node scripts/spa-packaging.mjs",
    "check:integration:administration": "node scripts/administration-access.mjs",
    "check:integration:agent-authoring": "node scripts/agent-authoring-access.mjs",
    "check:integration:agent-draft-editor": "node scripts/agent-draft-editor-access.mjs",
    "check:integration:agent-operational-view": "node scripts/agent-operational-view-access.mjs",
    "check:integration:approval": "node scripts/approval-access.mjs",
    "check:integration:audit": "node scripts/audit-access.mjs",
    "check:integration:configuration": "node scripts/configuration-access.mjs",
    "check:integration:console": "node scripts/console-access.mjs",
    "check:integration:deployment": "node scripts/deployment-access.mjs",
    "check:integration:evaluation": "node scripts/evaluation-access.mjs",
    "check:integration:organization": "node scripts/organization-access.mjs",
    "check:integration:organization-overview": "node scripts/organization-overview-access.mjs",
    "check:integration:organization-project-directory": "node scripts/organization-project-directory-access.mjs",
    "check:integration:project-agent-list": "node scripts/project-agent-list-access.mjs",
    "check:integration:project-dashboard": "node scripts/project-dashboard-access.mjs",
    "check:integration:audit-transaction": "node scripts/audit-transaction.mjs",
    "check:integration:audit-plan": "node scripts/audit-query-plan.mjs",
    "check:integration:deployment-harness": "node scripts/deployment-harness.mjs",
    "check:integration:mvp-shared": "node scripts/mvp-shared-fixture.mjs",
    "check:e2e:administration-settings": "npm run build:console && node scripts/administration-settings.e2e.mjs",
    "check:e2e:agent-authoring": "npm run build:console && node scripts/agent-authoring.e2e.mjs",
    "check:e2e:agent-draft-editor": "npm run build:console && node scripts/agent-draft-editor.e2e.mjs",
    "check:e2e:agent-operational-view": "npm run build:console && node scripts/agent-operational-view.e2e.mjs",
    "check:e2e:approval": "npm run build:console && node scripts/approval.e2e.mjs",
    "check:e2e:audit": "npm run build:console && node scripts/audit.e2e.mjs",
    "check:e2e:configuration": "npm run build:console && node scripts/configuration.e2e.mjs",
    "check:e2e:console-context": "npm run build:console && node scripts/console-context.e2e.mjs",
    "check:e2e:console-navigation": "npm run build:console && node scripts/console-navigation.e2e.mjs",
    "check:e2e:deployment": "npm run build:console && node scripts/deployment.e2e.mjs",
    "check:e2e:evaluation": "npm run build:console && node scripts/evaluation.e2e.mjs",
    "check:e2e:organization-overview": "npm run build:console && node scripts/organization-overview.e2e.mjs",
    "check:e2e:organization-project-authoring": "npm run build:console && node scripts/organization-project-authoring.e2e.mjs",
    "check:e2e:organization-project-list": "npm run build:console && node scripts/organization-project-list.e2e.mjs",
    "check:e2e:organization-selector": "npm run build:console && node scripts/organization-selector.e2e.mjs",
    "check:e2e:project-agent-list": "npm run build:console && node scripts/project-agent-list.e2e.mjs",
    "check:e2e:project-dashboard": "npm run build:console && node scripts/project-dashboard.e2e.mjs",
    "check:mvp-acceptance": "node scripts/mvp-acceptance.mjs",
    "check:mvp-accessibility": "node scripts/mvp-accessibility.mjs",
    "build:console": "npm run --workspace @hive/console-editor build && cd crates/hive-console && trunk build --release --cargo-profile wasm-release && cd ../.. && node scripts/precompress.mjs crates/hive-console/dist"
  }
}
